    "GetBoneRotate": {
      "type": "info",
      "message": "存在しないボーン名を指定した場合、ゼロQuaternionが返ります。",
      "messageEn": "Returns zero Quaternion if bone name doesn't exist."
    },
    "SendMessage": {
      "type": "info",
      "message": "全てのコンポーネントに対して同一フレーム内で同期的に処理されます。",
      "messageEn": "Processed synchronously within the same frame for all components."
    },
    "IsAlive": {
      "type": "tip",
      "message": "複製したItemが破棄されたかどうかを確認するのに便利です。",
      "messageEn": "Useful for checking if a cloned Item has been destroyed."
    },
    "ReplaceBackupTexture": {
      "type": "tip",
      "message": "ReplaceTextureで差し替えたテクスチャを元に戻す際に使用します。",
