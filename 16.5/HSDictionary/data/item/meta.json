  "warnings": {
    "PlayVideo": {
      "type": "warning",
      "message": "再生中に呼ぶと停止してしまいます。SwitchVideoの使用を推奨します。",
      "messageEn": "Calling while playing will stop it. Use SwitchVideo instead."
    },
    "SetProperty": {
      "type": "info",
      "message": "他プレイヤーとは同期されません（ローカル専用）",
      "messageEn": "Not synced with other players (local only)"
    },
    "GetProperty": {
      "type": "info",
      "message": "存在しないKeyは空文字列を返します",
      "messageEn": "Returns empty string for non-existent keys"
    },
    "Unload": {
      "type": "warning",
      "message": "メモリから完全に解放されます。再度使用するにはLoadが必要です。",
      "messageEn": "Completely released from memory. Load() required for reuse."
    },
    "SetCollisionDetection": {
      "type": "info",
      "message": "Item全体の衝突判定です。ノード単位はSetEnableColliderを使用してください。",
      "messageEn": "Collision for entire Item. Use SetEnableCollider for per-node control."
    },
    "SetEnableCollider": {
      "type": "info",
      "message": "子オブジェクト単位の衝突判定です。Item全体はSetCollisionDetectionを使用してください。",
      "messageEn": "Per-child collision. Use SetCollisionDetection for entire Item."
    },
    "ClearTextPlane": {
      "type": "tip",
      "message": "WriteTextPlaneの前に呼ぶことで、テキストが重複表示されるのを防げます。",
      "messageEn": "Call before WriteTextPlane to prevent duplicate text display."
    },
    "MovePos": {
      "type": "tip",
      "message": "IsMoving()で移動完了を確認できます。",
      "messageEn": "Use IsMoving() to check movement completion."
    },
    "ChangeMotion": {
      "type": "tip",
      "message": "BlendTimeMSを指定すると滑らかにモーションが遷移します。",
      "messageEn": "Specify BlendTimeMS for smooth motion transition."
    },
    "Equals": {
      "type": "info",
      "message": "==は型比較のみ。Equalsは内部データまで比較します。hsItemGet()で取得した同一Itemの別インスタンスも正しく判定できます。",
      "messageEn": "== only compares types. Equals compares internal data. Correctly identifies same Item from different hsItemGet() calls."
    },
    "SetPropertyWithoutNotify": {
      "type": "info",
      "message": "OnChangedPropertyコールバックが発生しません。パフォーマンス最適化や無限ループ防止に使用します。",
      "messageEn": "OnChangedProperty callback is not triggered. Use for performance optimization or preventing infinite loops."
    },
    "RemovePropertyWithoutNotify": {
      "type": "info",
      "message": "OnRemovedPropertyコールバックが発生しません。",
      "messageEn": "OnRemovedProperty callback is not triggered."
    },
    "GetBonePos": {
      "type": "info",
      "message": "存在しないボーン名を指定した場合、Vector3(0,0,0)が返ります。",
      "messageEn": "Returns Vector3(0,0,0) if bone name doesn't exist."
    },
    "GetBoneWorldPos": {
      "type": "info",
      "message": "存在しないボーン名を指定した場合、Vector3(0,0,0)が返ります。",
      "messageEn": "Returns Vector3(0,0,0) if bone name doesn't exist."
